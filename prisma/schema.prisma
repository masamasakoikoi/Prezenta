// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int     @id @default(autoincrement())
  email          String  @unique
  name           String?
  password       String
  branch         String?
  employmentType String?
  role           String  @default("user") // "user" | "admin"
  employeeNumber String?
  lastName       String?
  firstName      String?
  nameKana       String?

  attendances Attendance[]
  reports Report[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      String
  status    String
  startTime String?
  finishTime   String?
  checkIn        String?   // 追加
  checkOut       String?   // 追加
  comment        String  @default("")  // 追加
  location       String?               // 都道府県〜市区町村
  approvalStatus String?   // null | "pending" | "approved" | "cancelled"

  @@unique([userId, date])
}

model Report {
  id        Int @id @default(autoincrement())
  userId    Int
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  date      String
  reason    String?
  status    String @default("pending")
  createdAt DateTime @default(now())
}